# USB serial adapter on Raspberry Pi. Prefer /dev/serial/by-id/... if available.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_BYTESIZE=8
SERIAL_PARITY=N
SERIAL_STOPBITS=1
SERIAL_TIMEOUT=0.15
SERIAL_WRITE_TIMEOUT=1
DEVICE_ADDRESS=0
DEFAULT_ZONE=1
# Decimal zone numbers shown in the remote's selector (AVR507: 1,2).
REMOTE_ZONES=1,2
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Set true to preview without a receiver. Nothing will be transmitted.
DRY_RUN=false
