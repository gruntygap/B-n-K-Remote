[Unit]
Description=B&K receiver web remote
After=network.target

[Service]
Type=simple
# Change both the user and paths to match your Pi's account and checkout.
User=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/B-n-K-Remote
ExecStart=/home/pi/B-n-K-Remote/.venv/bin/python control.py --serve
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
